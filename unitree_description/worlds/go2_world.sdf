<?xml version="1.0"?>
<sdf version="1.9">
  <world name="go2_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Boden: Wohnzimmer und Schlafzimmer -->
    <model name="floor">
      <static>true</static>
      <pose>0.5 0 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>9.15 6.15 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>9.15 6.15 0.1</size></box></geometry>
          <material>
            <ambient>0.55 0.52 0.47 1</ambient>
            <diffuse>0.68 0.65 0.60 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Außenwände -->
    <model name="wall_back">
      <static>true</static>
      <pose>0.5 3 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>9.15 0.15 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>9.15 0.15 2.5</size></box></geometry>
          <material><ambient>0.8 0.8 0.78 1</ambient><diffuse>0.9 0.9 0.88 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_front">
      <static>true</static>
      <pose>0.5 -3 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>9.15 0.15 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>9.15 0.15 2.5</size></box></geometry>
          <material><ambient>0.8 0.8 0.78 1</ambient><diffuse>0.9 0.9 0.88 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_left">
      <static>true</static>
      <pose>-4 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 6 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 6 2.5</size></box></geometry>
          <material><ambient>0.8 0.8 0.78 1</ambient><diffuse>0.9 0.9 0.88 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_right">
      <static>true</static>
      <pose>5 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 6 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 6 2.5</size></box></geometry>
          <material><ambient>0.8 0.8 0.78 1</ambient><diffuse>0.9 0.9 0.88 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Trennwand mit Durchgang: y von -0.55 bis +0.55 bleibt frei -->
    <model name="partition_lower">
      <static>true</static>
      <pose>1  -1.775 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 2.45 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 2.45 2.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="partition_upper">
      <static>true</static>
      <pose>1 1.775 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 2.45 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 2.45 2.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Wohnzimmer: Holztisch -->
    <model name="wood_table">
      <static>true</static>
      <pose>-2 0.8 0 0 0 0</pose>
      <link name="tabletop">
        <pose>0 0 0.72 0 0 0</pose>
        <collision name="collision"><geometry><box><size>1.5 0.85 0.10</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.5 0.85 0.10</size></box></geometry>
          <material><ambient>0.38 0.20 0.08 1</ambient><diffuse>0.58 0.32 0.14 1</diffuse></material>
        </visual>
      </link>
      <link name="leg1"><pose>-0.62 -0.32 0.34 0 0 0</pose><collision name="c"><geometry><box><size>0.10 0.10 0.68</size></box></geometry></collision><visual name="v"><geometry><box><size>0.10 0.10 0.68</size></box></geometry><material><diffuse>0.35 0.18 0.08 1</diffuse></material></visual></link>
      <link name="leg2"><pose>0.62 -0.32 0.34 0 0 0</pose><collision name="c"><geometry><box><size>0.10 0.10 0.68</size></box></geometry></collision><visual name="v"><geometry><box><size>0.10 0.10 0.68</size></box></geometry><material><diffuse>0.35 0.18 0.08 1</diffuse></material></visual></link>
      <link name="leg3"><pose>-0.62 0.32 0.34 0 0 0</pose><collision name="c"><geometry><box><size>0.10 0.10 0.68</size></box></geometry></collision><visual name="v"><geometry><box><size>0.10 0.10 0.68</size></box></geometry><material><diffuse>0.35 0.18 0.08 1</diffuse></material></visual></link>
      <link name="leg4"><pose>0.62 0.32 0.34 0 0 0</pose><collision name="c"><geometry><box><size>0.10 0.10 0.68</size></box></geometry></collision><visual name="v"><geometry><box><size>0.10 0.10 0.68</size></box></geometry><material><diffuse>0.35 0.18 0.08 1</diffuse></material></visual></link>
    </model>

    <!-- Zwei Stühle mit Holzbeinen und Rückenlehne -->
    <model name="chair_1">
      <static>true</static><pose>-2 -0.15 0 0 0 3.14159</pose>
      <link name="seat"><pose>0 0 0.45 0 0 0</pose><collision name="c"><geometry><box><size>0.48 0.48 0.10</size></box></geometry></collision><visual name="v"><geometry><box><size>0.48 0.48 0.10</size></box></geometry><material><diffuse>0.55 0.32 0.16 1</diffuse></material></visual></link>
      <link name="back"><pose>0 0.20 0.78 0 0 0</pose><collision name="c"><geometry><box><size>0.48 0.08 0.58</size></box></geometry></collision><visual name="v"><geometry><box><size>0.48 0.08 0.58</size></box></geometry><material><diffuse>0.55 0.32 0.16 1</diffuse></material></visual></link>
      <link name="leg1"><pose>-0.17 -0.17 0.22 0 0 0</pose><collision name="c"><geometry><box><size>0.07 0.07 0.44</size></box></geometry></collision><visual name="v"><geometry><box><size>0.07 0.07 0.44</size></box></geometry><material><diffuse>0.32 0.16 0.07 1</diffuse></material></visual></link>
      <link name="leg2"><pose>0.17 -0.17 0.22 0 0 0</pose><collision name="c"><geometry><box><size>0.07 0.07 0.44</size></box></geometry></collision><visual name="v"><geometry><box><size>0.07 0.07 0.44</size></box></geometry><material><diffuse>0.32 0.16 0.07 1</diffuse></material></visual></link>
      <link name="leg3"><pose>-0.17 0.17 0.22 0 0 0</pose><collision name="c"><geometry><box><size>0.07 0.07 0.44</size></box></geometry></collision><visual name="v"><geometry><box><size>0.07 0.07 0.44</size></box></geometry><material><diffuse>0.32 0.16 0.07 1</diffuse></material></visual></link>
      <link name="leg4"><pose>0.17 0.17 0.22 0 0 0</pose><collision name="c"><geometry><box><size>0.07 0.07 0.44</size></box></geometry></collision><visual name="v"><geometry><box><size>0.07 0.07 0.44</size></box></geometry><material><diffuse>0.32 0.16 0.07 1</diffuse></material></visual></link>
    </model>

    <model name="chair_2">
      <static>true</static><pose>-2 1.75 0 0 0 0</pose>
      <link name="seat"><pose>0 0 0.45 0 0 0</pose><collision name="c"><geometry><box><size>0.48 0.48 0.10</size></box></geometry></collision><visual name="v"><geometry><box><size>0.48 0.48 0.10</size></box></geometry><material><diffuse>0.55 0.32 0.16 1</diffuse></material></visual></link>
      <link name="back"><pose>0 0.20 0.78 0 0 0</pose><collision name="c"><geometry><box><size>0.48 0.08 0.58</size></box></geometry></collision><visual name="v"><geometry><box><size>0.48 0.08 0.58</size></box></geometry><material><diffuse>0.55 0.32 0.16 1</diffuse></material></visual></link>
      <link name="leg1"><pose>-0.17 -0.17 0.22 0 0 0</pose><collision name="c"><geometry><box><size>0.07 0.07 0.44</size></box></geometry></collision><visual name="v"><geometry><box><size>0.07 0.07 0.44</size></box></geometry><material><diffuse>0.32 0.16 0.07 1</diffuse></material></visual></link>
      <link name="leg2"><pose>0.17 -0.17 0.22 0 0 0</pose><collision name="c"><geometry><box><size>0.07 0.07 0.44</size></box></geometry></collision><visual name="v"><geometry><box><size>0.07 0.07 0.44</size></box></geometry><material><diffuse>0.32 0.16 0.07 1</diffuse></material></visual></link>
      <link name="leg3"><pose>-0.17 0.17 0.22 0 0 0</pose><collision name="c"><geometry><box><size>0.07 0.07 0.44</size></box></geometry></collision><visual name="v"><geometry><box><size>0.07 0.07 0.44</size></box></geometry><material><diffuse>0.32 0.16 0.07 1</diffuse></material></visual></link>
      <link name="leg4"><pose>0.17 0.17 0.22 0 0 0</pose><collision name="c"><geometry><box><size>0.07 0.07 0.44</size></box></geometry></collision><visual name="v"><geometry><box><size>0.07 0.07 0.44</size></box></geometry><material><diffuse>0.32 0.16 0.07 1</diffuse></material></visual></link>
    </model>

    <!-- Sofa: grauer Korpus, Sitzfläche und Rückenlehne -->
    <model name="sofa">
      <static>true</static><pose>-1.8 -1.9 0 0 0 3.14159</pose>
      <link name="base"><pose>0 0 0.30 0 0 0</pose><collision name="c"><geometry><box><size>2.0 0.85 0.60</size></box></geometry></collision><visual name="v"><geometry><box><size>2.0 0.85 0.60</size></box></geometry><material><diffuse>0.35 0.38 0.40 1</diffuse></material></visual></link>
      <link name="back"><pose>0 0.32 0.75 0 0 0</pose><collision name="c"><geometry><box><size>2.0 0.22 0.90</size></box></geometry></collision><visual name="v"><geometry><box><size>2.0 0.22 0.90</size></box></geometry><material><diffuse>0.42 0.45 0.47 1</diffuse></material></visual></link>
      <link name="arm_left"><pose>-0.92 0 0.55 0 0 0</pose><collision name="c"><geometry><box><size>0.20 0.85 0.50</size></box></geometry></collision><visual name="v"><geometry><box><size>0.20 0.85 0.50</size></box></geometry><material><diffuse>0.42 0.45 0.47 1</diffuse></material></visual></link>
      <link name="arm_right"><pose>0.92 0 0.55 0 0 0</pose><collision name="c"><geometry><box><size>0.20 0.85 0.50</size></box></geometry></collision><visual name="v"><geometry><box><size>0.20 0.85 0.50</size></box></geometry><material><diffuse>0.42 0.45 0.47 1</diffuse></material></visual></link>
    </model>

    <!-- Schrank im Wohnzimmer -->
    <model name="cabinet">
      <static>true</static><pose>4.5 2.2 0.9 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.2 0.55 1.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.2 0.55 1.8</size></box></geometry><material><diffuse>0.72 0.68 0.58 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Schlafzimmer: Bett mit Holzrahmen und heller Matratze -->
    <model name="bed">
      <static>true</static><pose>3.875 0.0 0 0 0 3.14159</pose>
      <link name="frame"><pose>0 0 0.18 0 0 0</pose><collision name="c"><geometry><box><size>2.1 1.6 0.36</size></box></geometry></collision><visual name="v"><geometry><box><size>2.1 1.6 0.36</size></box></geometry><material><diffuse>0.42 0.23 0.10 1</diffuse></material></visual></link>
      <link name="mattress"><pose>0 0 0.42 0 0 0</pose><collision name="c"><geometry><box><size>2.0 1.5 0.20</size></box></geometry></collision><visual name="v"><geometry><box><size>2.0 1.5 0.20</size></box></geometry><material><diffuse>0.88 0.86 0.80 1</diffuse></material></visual></link>
      <link name="headboard"><pose>-1.0 0 0.75 0 0 0</pose><collision name="c"><geometry><box><size>0.12 1.6 0.9</size></box></geometry></collision><visual name="v"><geometry><box><size>0.12 1.6 0.9</size></box></geometry><material><diffuse>0.42 0.23 0.10 1</diffuse></material></visual></link>
      <link name="blanket"><pose>0.45 0 0.54 0 0 0</pose><collision name="c"><geometry><box><size>1.0 1.48 0.06</size></box></geometry></collision><visual name="v"><geometry><box><size>1.0 1.48 0.06</size></box></geometry><material><diffuse>0.35 0.48 0.58 1</diffuse></material></visual></link>
    </model>

  </world>
</sdf>
