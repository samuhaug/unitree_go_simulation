<?xml version="1.0"?>
<robot name="go2" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find unitree_description)/urdf/const.xacro"/>
    <xacro:include filename="$(find unitree_description)/urdf/leg.xacro"/>
    <xacro:include filename="$(find unitree_description)/urdf/lidar.xacro"/>

    <link name="trunk">
        <visual>
            <geometry>
                <mesh
                    filename="package://unitree_description/meshes/trunk.dae"
                    scale="1 1 1"/>
            </geometry>
        </visual>

        <collision>
            <geometry>
                <box size="${trunk_length} ${trunk_width} ${trunk_height}"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0.021112 0.0 -0.005366" rpy="0 0 0"/>
            <mass value="${trunk_mass}"/>
            <inertia
                ixx="0.02448"
                ixy="0.00012166"
                ixz="0.0014849"
                iyy="0.098077"
                iyz="-3.12E-05"
                izz="0.107"/>
        </inertial>
    </link>

    <xacro:leg name="FL" mirror="1" front_hind="1"/>
    <xacro:leg name="FR" mirror="-1" front_hind="1"/>
    <xacro:leg name="RL" mirror="1" front_hind="-1"/>
    <xacro:leg name="RR" mirror="-1" front_hind="-1"/>

    <xacro:lidar_sensor/>

</robot>
